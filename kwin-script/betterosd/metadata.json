        "Authors": [
            {
                "Name": "Rocco Rakete",
                "Email": "m.schaumann@mscloud.uk"
            }
        ],
        "License": "GPL-2.0-or-later",
        "Icon": "preferences-desktop-notification",
        "Version": "0.2.0",
        "EnabledByDefault": true
    }
}
